# Copy to `.env` and fill in values. Never commit real secrets.
# Full local setup instructions: docs/LOCAL_SETUP.md (roadmap step 013).

# --- App / Payload ---
# Postgres connection. Local Docker default below; Neon: `neon deploy` / `neon env pull` overwrites with pooled URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog
# Neon direct (non-pooler) URL — migrations only (`npm run migrate`). Written by `neon env pull`.
DATABASE_URL_UNPOOLED=
# Neon branch metadata (optional; from `neon env pull`).
NEON_BRANCH=
NEON_BRANCH_ID=
# Long random string used to sign sessions/tokens (required).
PAYLOAD_SECRET=replace-with-long-random-string
# Draft preview gate (admin Preview button → /next/preview). Long random string; never commit real value.
PREVIEW_SECRET=replace-with-long-random-preview-secret
# Public origin of the app (no trailing slash). Used for absolute links, RSS, OG, CSRF.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional contact address on /about (step 054). Empty → no mailto link. Not a form and not a newsletter.
CONTACT_EMAIL=

# --- Admin bootstrap (seed, step 040) ---
# Used by `npm run seed:admin`. Do not leave password as replace-me.
# Password changes: update in /admin or directly in the database — no email reset.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# --- Cloudflare R2 (S3-compatible media storage, step 037) ---
# Leave empty locally → Payload writes to repo-root media/. When all required vars are set → R2.
# Setup: docs/runbooks/r2-media.md
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint (uploads only): https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# Public base URL for objects (R2.dev subdomain or custom domain). No trailing slash required.
R2_PUBLIC_URL=
