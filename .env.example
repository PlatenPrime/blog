# Copy to `.env` and fill in values. Never commit real secrets.
# Full local setup instructions: docs/LOCAL_SETUP.md (roadmap step 013).

# --- App / Payload ---
# Local Docker Postgres (roadmap step 007); Neon connection string in preview/prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog
# Long random string used to sign sessions/tokens (required).
PAYLOAD_SECRET=replace-with-long-random-string
# Public origin of the app (no trailing slash). Used for links, OAuth redirects, emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Admin bootstrap (seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# --- Cloudflare R2 (S3-compatible media storage) ---
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# Public base URL for uploaded objects (custom domain or R2.dev URL).
R2_PUBLIC_URL=

# --- Resend (transactional email: verify + password reset) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# --- Google OAuth (reader login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare Turnstile (bot protection; site key is public) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
