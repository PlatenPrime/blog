# Copy to `.env` and fill in values. Never commit real secrets.
# Full local setup instructions: docs/LOCAL_SETUP.md (roadmap step 013).

# --- App / Payload ---
# Local Docker Postgres (roadmap step 007); Neon connection string in preview/prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog
# Long random string used to sign sessions/tokens (required).
PAYLOAD_SECRET=replace-with-long-random-string
# Draft preview gate (admin Preview button → /next/preview). Long random string; never commit real value.
PREVIEW_SECRET=replace-with-long-random-preview-secret
# Public origin of the app (no trailing slash). Used for links, OAuth redirects, emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional contact address on /about (step 054). Empty → no mailto link. Not a form and not a newsletter.
CONTACT_EMAIL=

# --- Admin bootstrap (seed, step 040) ---
# Used by `npm run seed:admin`. Do not leave password as replace-me.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# --- Cloudflare R2 (S3-compatible media storage, step 037) ---
# Leave empty locally → Payload writes to repo-root media/. When all required vars are set → R2.
# Setup: docs/runbooks/r2-media.md
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint (uploads only): https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# Public base URL for objects (R2.dev subdomain or custom domain). No trailing slash required.
R2_PUBLIC_URL=

# --- Resend (transactional email: verify + password reset) ---
# Leave empty locally → Payload console email adapter (see docs/LOCAL_SETUP.md).
# Live path (onboarding From, DNS, smoke): docs/runbooks/resend-email.md (step 082).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# --- Google OAuth (reader login) ---
# Optional locally. Setup: docs/google-oauth-setup.md
# Redirect URI: {NEXT_PUBLIC_SERVER_URL}/api/users/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Upstash Redis (rate limiting only, ADR-006 / step 074) ---
# Leave empty locally → in-memory fixed window (per process). Production: Upstash REST.
# Create a free Redis database: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (bot protection; site key is public) ---
# Empty locally → verify skipped (forms work). Production: real keys from Cloudflare dashboard.
# Dummy poke keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Always passes: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Always fails:  site 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
