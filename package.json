{
  "name": "blog",
  "version": "1.0.0",
  "description": "Personal blog — Next.js + Payload CMS v3",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:deploy": "npm run migrate && npm run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "commitlint": "commitlint",
    "migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx --import ./src/scripts/withDirectDatabaseUrl.ts ./node_modules/payload/bin.js migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx --import ./src/scripts/withDirectDatabaseUrl.ts ./node_modules/payload/bin.js migrate:status",
    "seed:admin": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/scripts/seedAdmin.ts",
    "backfill:search-text": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/scripts/backfillSearchText.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.int.config.mts"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@payloadcms/db-postgres": "^3.93.0",
    "@payloadcms/db-vercel-postgres": "^3.93.0",
    "@payloadcms/next": "^3.93.0",
    "@payloadcms/richtext-lexical": "^3.93.0",
    "@payloadcms/storage-s3": "^3.93.0",
    "@payloadcms/ui": "^3.90.2",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cross-env": "^7.0.3",
    "dotenv": "18.0.9",
    "graphql": "^16.8.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "payload": "^3.93.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "28.0.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "allowScripts": {
    "sharp": true,
    "esbuild": true
  }
}
